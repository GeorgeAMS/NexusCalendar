NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://nexus:nexus@localhost:5433/nexus_calendar?schema=public"

JWT_ACCESS_SECRET=cambia-esto-en-local
JWT_REFRESH_SECRET=cambia-esto-tambien
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

APP_TIMEZONE=America/Bogota
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
# URL del front usada en los correos. Si se omite, se toma el primer CORS_ORIGIN.
APP_WEB_URL=http://localhost:5173

# --- Correo ---
# Produccion Railway (Hobby): SMTP bloqueado → API HTTPS.
#
# Brevo (recomendado): enviar a CUALQUIER correo sin DNS de la clinica.
# Remitente: nexuscalendar2026@gmail.com (verificar en Brevo → Senders).
# 1) https://app.brevo.com (cuenta con ese Gmail)
# 2) Settings → Senders → verificar nexuscalendar2026@gmail.com
# 3) Settings → SMTP & API → API Keys → Create (clave REST, no SMTP)
# 4) BREVO_API_KEY=xkeysib-...
BREVO_API_KEY=
MAIL_FROM="Nexus Calendar <nexuscalendar2026@gmail.com>"

# Resend (alternativa): onboarding@ solo llega a tu propio correo;
# otros destinatarios exigen dominio verificado.
# RESEND_API_KEY=
# MAIL_FROM="Nexus Calendar <onboarding@resend.dev>"

# Local Mailhog (http://localhost:8025). Prioridad: BREVO > RESEND > SMTP.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Web Push opcional. Sin claves el push queda deshabilitado y solo se envia correo.
# Generar con: npm run push:keys (en apps/api) y pegar el par aqui.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

ADMIN_SEED_EMAIL=admin@nexus.local
ADMIN_SEED_PASSWORD=Admin123*
ADMIN_SEED_NAME=Administrador Nexus
ADMIN_SEED_PHONE=3000000000

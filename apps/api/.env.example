NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://nexus:nexus@localhost:5433/nexus_calendar?schema=public"

JWT_ACCESS_SECRET=cambia-esto-en-local
JWT_REFRESH_SECRET=cambia-esto-tambien
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

APP_TIMEZONE=America/Bogota
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
# URL del front usada en los correos. Si se omite, se toma el primer CORS_ORIGIN.
APP_WEB_URL=http://localhost:5173

# --- Correo ---
# Local (Mailhog en docker compose): captura en http://localhost:8025 sin llegar a internet.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Nexus Calendar <nexus@localhost>"

# Correo real con Gmail (ejemplo — NO uses tu contraseña normal; usa "Contraseña de aplicación"):
# 1) Activa 2FA en tu cuenta Google
# 2) https://myaccount.google.com/apppasswords → generar para "Correo"
# 3) Sustituye abajo y reinicia la API (npm run start:dev en apps/api)
# 4) Prueba: npm run mail:test -- tu@gmail.com
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_SECURE=false
# MAIL_FROM="Nexus Calendar <tu@gmail.com>"
#
# Outlook / Hotmail:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=tu@outlook.com
# SMTP_PASS=tu-clave-o-app-password
# SMTP_SECURE=false
# MAIL_FROM="Nexus Calendar <tu@outlook.com>"

# Web Push opcional. Sin claves el push queda deshabilitado y solo se envia correo.
# Generar con: npm run push:keys (en apps/api) y pegar el par aqui.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

ADMIN_SEED_EMAIL=admin@nexus.local
ADMIN_SEED_PASSWORD=Admin123*
ADMIN_SEED_NAME=Administrador Nexus
ADMIN_SEED_PHONE=3000000000
